le="background-color:#ffffff;--shiki-dark-bg:#0B0C0E;color:#1f2328;--shiki-dark:#D4D4D4" language="json"><code language="json" numberOfLines="7"><span class="line"><span style="color:#1F2328;--shiki-dark:#D4D4D4">{</span></span>
