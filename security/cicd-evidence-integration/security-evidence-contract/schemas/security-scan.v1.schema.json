{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northstar.security-scan.v1",
  "title": "安全扫描证据",
  "description": "Northstar 安全扫描规范化证据。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "subject",
    "tool",
    "execution",
    "isolation",
    "coverage",
    "findings",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "northstar.security-scan.v1"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "subject": {
      "$ref": "#/$defs/scanSubject"
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "isolation": {
      "$ref": "#/$defs/isolation"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "findings": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {
            "properties": {
              "name": {
                "const": "semgrep"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tool": {
            "properties": {
              "rules_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "database": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "properties": {
              "name": {
                "const": "osv-scanner"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tool": {
            "properties": {
              "rules_sha256": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "anyOf": [
        {
          "minLength": 40,
          "maxLength": 40
        },
        {
          "minLength": 64,
          "maxLength": 64
        }
      ]
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "not": {
        "pattern": "[^A-Za-z0-9._-]"
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "maxLength": 32
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "bounded": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "ecosystems": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/bounded"
      },
      "uniqueItems": true
    },
    "runSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_commit",
        "patch_sha256",
        "candidate_manifest_sha256",
        "scan_view_manifest_sha256"
      ],
      "properties": {
        "start_commit": {
          "$ref": "#/$defs/commit"
        },
        "patch_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scan_view_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scanSubject": {
      "$ref": "#/$defs/runSubject"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "distribution_sha256",
        "normalizer_sha256",
        "config_sha256",
        "rules_sha256",
        "database"
      ],
      "properties": {
        "name": {
          "enum": [
            "semgrep",
            "osv-scanner"
          ]
        },
        "version": {
          "$ref": "#/$defs/bounded"
        },
        "distribution_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalizer_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rules_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "database": {
          "anyOf": [
            {
              "$ref": "#/$defs/database"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "updated_at",
        "ecosystems"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ecosystems": {
          "$ref": "#/$defs/ecosystems"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "started_at",
        "finished_at",
        "duration_ms",
        "exit_code",
        "timed_out",
        "resource_exhausted",
        "output_truncated"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "timed_out",
            "resource_exhausted",
            "error",
            "not_applicable"
          ]
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -255,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "resource_exhausted": {
          "type": "boolean"
        },
        "output_truncated": {
          "type": "boolean"
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "read_only_inputs",
        "network",
        "credentials",
        "project_code_executed",
        "non_root"
      ],
      "properties": {
        "backend": {
          "enum": [
            "oci",
            "bwrap",
            "vm",
            "none",
            "process",
            "unknown"
          ]
        },
        "read_only_inputs": {
          "type": "boolean"
        },
        "network": {
          "enum": [
            "denied",
            "allowed",
            "unknown"
          ]
        },
        "credentials": {
          "enum": [
            "none",
            "present",
            "unknown"
          ]
        },
        "project_code_executed": {
          "type": "boolean"
        },
        "non_root": {
          "type": "boolean"
        }
      }
    },
    "observedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "ecosystems",
        "package_count"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ecosystems": {
          "$ref": "#/$defs/ecosystems"
        },
        "package_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "skippedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "reason": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observed_inputs",
        "skipped_inputs",
        "unresolved_inputs",
        "error_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "not_applicable"
          ]
        },
        "observed_inputs": {
          "type": "array",
          "maxItems": 4000,
          "items": {
            "$ref": "#/$defs/observedInput"
          }
        },
        "skipped_inputs": {
          "type": "array",
          "maxItems": 4000,
          "items": {
            "$ref": "#/$defs/skippedInput"
          }
        },
        "unresolved_inputs": {
          "type": "array",
          "maxItems": 4000,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "error_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "ecosystem"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/bounded"
        },
        "version": {
          "$ref": "#/$defs/bounded"
        },
        "ecosystem": {
          "$ref": "#/$defs/bounded"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "rule_id",
        "advisory_id",
        "severity",
        "location",
        "package",
        "message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/bounded"
        },
        "kind": {
          "enum": [
            "rule",
            "advisory"
          ]
        },
        "rule_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/bounded"
            },
            {
              "type": "null"
            }
          ]
        },
        "advisory_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/bounded"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "unknown"
          ]
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "package": {
          "anyOf": [
            {
              "$ref": "#/$defs/package"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr"
      ],
      "properties": {
        "stdout": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/artifact"
                },
                {
                  "properties": {
                    "bytes": {
                      "maximum": 1048576
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
