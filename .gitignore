# Python
__pycache__/
*.py[cod]

# Packaging artifacts
build/
dist/
*.egg-info/

# Local runtime state
.env
*.log
*.sock
# Product-path session transcripts (agent default: <workspace>/.northstar/sessions)
**/.northstar/sessions/

# Build and editor artifacts
.DS_Store
.vscode/
.idea/

# Delivery bundles (b173-*.bundle): a git bundle is a DELIVERY ARTEFACT, not
# source.  The batch's bundles were being written into the repo root by the
# delivery step, where `git add -A` would have committed a 70 MB binary.
*.bundle
